# Copy this file to .env and paste your key after the = sign.
# .env is git-ignored, so the key never reaches GitHub.
# A Gemini API key from Google AI Studio. To use Vertex AI instead, also set GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_API_KEY=
# Optional: force a specific model instead of the built-in list
# GEMINI_MODEL=gemini-2.5-flash
